[Desktop Entry]
Type=Application
Name=IndigoSky Trust Launchers
Exec=sh -c 'for f in "$HOME/Desktop/indigo-control-panel.desktop" "$HOME/Desktop/ain-imager.desktop" "$HOME/Desktop/ain-viewer.desktop"; do [ -f "$f" ] && gio set "$f" metadata::trusted true 2>/dev/null; done'
NoDisplay=true
X-GNOME-Autostart-enabled=true
